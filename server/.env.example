# Postgres connection string (Render Postgres gives you this on the dashboard)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Port the Express server listens on (Render sets this for you in production)
PORT=3001

# Comma-separated list of origins allowed to call the API
ALLOWED_ORIGIN=https://nickhgriffiths.com,http://localhost:5173

# reCAPTCHA v3 secret key (from https://www.google.com/recaptcha/admin)
RECAPTCHA_SECRET_KEY=your-secret-key

# Resend API key (from https://resend.com/api-keys), and the address to notify on new posts
RESEND_API_KEY=your-resend-api-key
NOTIFY_EMAIL=nichg999@gmail.com
